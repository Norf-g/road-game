; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Город дорог"
boot_splash/image="res://assets/ui/splash_boot.png"
boot_splash/bg_color=Color(0.172549, 0.243137, 0.313726, 1)
boot_splash/stretch_mode=4
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/app/icon_192.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.ru.translation")
locale/fallback="ru"

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_touch_from_mouse=true
